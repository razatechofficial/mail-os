# Copy to .env for local development. Production values come from Vault.
APP_ENV=local

# IAM (contract §1, §5): the issuer whose JWKS verifies every token.
IAM_ISSUER=http://localhost:8081
IAM_AUDIENCE=mailos
# The MailOS console's OAuth client ID(s); console users' tokens carry it as aud.
IAM_CONSOLE_AUDIENCES=
# Contract §4 allow-list: client_id=topic.*|topic[@tenant_uuid];...
MAILOS_SERVICE_CLIENTS=mailos-iam=iam.*

# Key manager master key (base64, 32 bytes): openssl rand -base64 32
KEY_MANAGER_MASTER_KEY=

# PostgreSQL / Redis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mail_os
POSTGRES_SSL_MODE=disable
REDIS_HOST=localhost
REDIS_PORT=6379

# TLS (required outside local and test)
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=
HTTP_TLS_CLIENT_CA_FILE=
HTTP_TLS_CLIENT_AUTH=none
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CLIENT_CA_FILE=
GRPC_TLS_CLIENT_AUTH=none

# Kafka event ingestion (FEATURE_PUBSUB_INGEST) and audit stream (FEATURE_AUDIT_STREAM)
FEATURE_PUBSUB_INGEST=false
FEATURE_AUDIT_STREAM=false
KAFKA_BROKERS=
KAFKA_TLS_ENABLED=false
KAFKA_TLS_CA_FILE=
KAFKA_SASL_MECHANISM=none
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SASL_TOKEN_URL=
KAFKA_SASL_CLIENT_ID=
KAFKA_SASL_CLIENT_SECRET=

# Platform SMTP relay (used when a tenant has no provider)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
SMTP_FROM_ADDR=

MESSAGE_RETENTION_DAYS=30
