# Copy to .env for local development. Production values come from Vault.
APP_ENV=local

# IAM (contract §1, §5): the issuer whose JWKS verifies every token.
IAM_ISSUER=http://localhost:8081
IAM_AUDIENCE=mailos
# The MailOS console's OAuth client ID(s); console users' tokens carry it as aud.
IAM_CONSOLE_AUDIENCES=
# IAM's own client (contract §1), seeded at startup as the system
# application of that tenant. Every other project registers an application
# in the console (Integrations > Applications).
IAM_SERVICE_CLIENT_ID=mailos-iam
IAM_SERVICE_TENANT_ID=
IAM_SERVICE_TOPICS=iam.*
# How long an Idempotency-Key response is kept (1h to 168h).
IDEMPOTENCY_KEY_TTL=24h

# Key manager master key (base64, 32 bytes): openssl rand -base64 32
KEY_MANAGER_MASTER_KEY=
# Signs the audit digests (tamper evidence); required in production.
# A base64 32-byte Ed25519 seed: openssl rand -base64 32
AUDIT_DIGEST_SIGNING_KEY=
# Public keys of earlier signing keys, comma-separated, after a rotation
AUDIT_DIGEST_PREVIOUS_KEYS=

# PostgreSQL / Redis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mail_os
POSTGRES_SSL_MODE=disable
REDIS_HOST=localhost
REDIS_PORT=6379

# TLS (required outside local and test)
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=
HTTP_TLS_CLIENT_CA_FILE=
HTTP_TLS_CLIENT_AUTH=none
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CLIENT_CA_FILE=
GRPC_TLS_CLIENT_AUTH=none
# Largest gRPC request (0 = 4 MiB); a send carries its attachments in it
GRPC_MAX_RECV_BYTES=0

# Kafka event ingestion (FEATURE_PUBSUB_INGEST) and audit stream (FEATURE_AUDIT_STREAM)
FEATURE_PUBSUB_INGEST=false
FEATURE_AUDIT_STREAM=false
KAFKA_BROKERS=
KAFKA_TLS_ENABLED=false
KAFKA_TLS_CA_FILE=
KAFKA_SASL_MECHANISM=none
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SASL_TOKEN_URL=
KAFKA_SASL_CLIENT_ID=
KAFKA_SASL_CLIENT_SECRET=

# Platform SMTP relay (used when a tenant has no provider)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls
SMTP_FROM_ADDR=
# EHLO name; empty uses the domain of SMTP_FROM_ADDR
SMTP_HELO_NAME=

MESSAGE_RETENTION_DAYS=30

# One-click unsubscribe for broadcast mail (RFC 8058); off while the base URL is empty.
# The key is base64 or hex, at least 32 bytes: openssl rand -base64 32
UNSUBSCRIBE_BASE_URL=
UNSUBSCRIBE_SIGNING_KEY=
UNSUBSCRIBE_TOKEN_TTL=4320h
UNSUBSCRIBE_MAILTO=
UNSUBSCRIBE_RATE_PER_MINUTE=30

# Attachments on the send API and the SMTP relay (0 count turns them off)
ATTACHMENTS_MAX_BYTES=5242880
ATTACHMENTS_MAX_TOTAL_BYTES=10485760
ATTACHMENTS_MAX_COUNT=10
ATTACHMENTS_ALLOWED_TYPES=
ATTACHMENTS_BLOCKED_TYPES=
ATTACHMENTS_BLOCKED_EXTENSIONS=

# Virus scan of attachments with clamd over TCP (INSTREAM). Fail-closed
# refuses the send (503) when clamd cannot answer; false lets the file
# through unscanned and logs it.
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30s
CLAMAV_CHUNK_BYTES=65536
CLAMAV_FAIL_CLOSED=true
