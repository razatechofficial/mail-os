# Application
APP_ENV=local
APP_LOG_LEVEL=debug

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# gRPC Server
GRPC_HOST=0.0.0.0
GRPC_PORT=9090

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mail_os
POSTGRES_SSL_MODE=disable
POSTGRES_MAX_CONNS=25
POSTGRES_MIN_CONNS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue (pgqueue | redis | rabbitmq | nats | kafka)
QUEUE_BACKEND=pgqueue
QUEUE_RABBIT_URL=amqp://guest:guest@localhost:5672/
QUEUE_NATS_URL=nats://localhost:4222
QUEUE_KAFKA_BROKERS=localhost:9094

# SMTP Provider
SMTP_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=

# Encryption
ENCRYPTION_KEY=
HMAC_SECRET=

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_PER_ORG=100
RATE_LIMIT_BURST=20
