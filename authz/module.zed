// MailOS's ACS module (ADR 0001 §3.4, contract C4): the platform roles of
// the MailOS platform plane. One object, mailos/platform:global. Each role
// has an eligibility relation (eligible_<role>, plain, mirrored from the
// IAM's PIM) and an activation relation (<role>, expiring: MailOS writes it
// from the IAM's signed activation, with optional_expires_at = the
// activation's end). Only an activation grants anything: eligibility alone
// reaches no permission. The permissions are the MailOS route guards.
use expiration

definition mailos/platform {
	relation eligible_platform_owner: user
	relation eligible_platform_operator: user
	relation eligible_platform_template_editor: user
	relation eligible_platform_template_publisher: user
	relation eligible_platform_key_custodian: user
	relation eligible_platform_abuse_analyst: user
	relation eligible_platform_support: user
	relation eligible_platform_log_admin: user
	relation eligible_platform_auditor: user

	relation platform_owner: user with expiration
	relation platform_operator: user with expiration
	relation platform_template_editor: user with expiration
	relation platform_template_publisher: user with expiration
	relation platform_key_custodian: user with expiration
	relation platform_abuse_analyst: user with expiration
	relation platform_support: user with expiration
	relation platform_log_admin: user with expiration
	relation platform_auditor: user with expiration

	// Every active role sees the platform console's home page.
	permission view_overview = platform_owner + platform_operator + platform_template_editor + platform_template_publisher + platform_key_custodian + platform_abuse_analyst + platform_support + platform_log_admin + platform_auditor

	// Tenants: aggregates only, never content (content is the lockbox's).
	permission view_tenants = platform_owner + platform_operator + platform_abuse_analyst + platform_support + platform_auditor
	permission manage_tenants = platform_operator
	permission stop_send = platform_operator + platform_abuse_analyst

	// Connector and relay catalogue.
	permission view_connectors = platform_owner + platform_operator + platform_auditor

	// Platform templates (content): drafted by editors, published by
	// publishers (never their own drafts; MailOS enforces that).
	permission view_templates = platform_owner + platform_operator + platform_template_editor + platform_template_publisher + platform_auditor
	permission edit_templates = platform_template_editor
	permission publish_templates = platform_template_publisher

	// Configuration store: operators propose and approve settings (not
	// their own); key custodians the key-related ones. Which settings each
	// may touch is the config store's rule.
	permission view_config = platform_owner + platform_operator + platform_key_custodian + platform_auditor
	permission propose_config = platform_operator + platform_key_custodian
	permission approve_config = platform_operator + platform_key_custodian

	// Keys.
	permission manage_keys = platform_key_custodian

	// Platform audit (logs).
	permission view_audit = platform_owner + platform_log_admin + platform_auditor
	permission verify_audit = platform_log_admin
	permission export_audit = platform_log_admin
}
