{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error envelope"
      }
    },
    "schemas": {
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "acr_values": {
                "type": "string"
              },
              "code": {
                "enum": [
                  "BAD_REQUEST",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "STEP_UP_REQUIRED",
                  "FOUR_EYES_REQUIRED",
                  "NOT_FOUND",
                  "CONFLICT",
                  "VALIDATION",
                  "RATE_LIMITED",
                  "INTERNAL_SERVER_ERROR",
                  "SERVICE_UNAVAILABLE",
                  "PAYLOAD_TOO_LARGE"
                ],
                "type": "string"
              },
              "details": {
                "items": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "max_age": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "retry_after_seconds": {
                "type": "integer"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "success": {
            "const": false,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "IAM access token (aud mailos or the console client).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Transactional email for IAM and the MailOS console. Every /api/v1 operation needs an IAM access token (Bearer, or DPoP for sender-constrained tokens). Console users need a MailOS role (mailos_admin, mailos_template_editor, mailos_template_publisher, mailos_operator, mailos_auditor, mailos_viewer); sensitive operations need a sign-in no older than 5 minutes with a second factor and answer 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge otherwise.",
    "title": "MailOS API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analytics/audit-logs": {
      "get": {
        "operationId": "get_analytics_audit_logs",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List audit logs",
        "tags": [
          "analytics"
        ],
        "description": "The tenant's audit events in IAM's format, newest first. Each read is audited (audit_log.viewed). Permission: `audit:read`.",
        "x-permission": "audit:read"
      }
    },
    "/api/v1/analytics/audit-logs/export": {
      "get": {
        "operationId": "get_analytics_audit_logs_export",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Export audit logs",
        "tags": [
          "analytics"
        ],
        "description": "Up to 10,000 events; audited as audit_log.exported. Permission: `audit:export`. Needs step-up (a sign-in with a second factor within 5 minutes); otherwise 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge.",
        "x-step-up": true,
        "x-permission": "audit:export"
      }
    },
    "/api/v1/keys/encryption": {
      "get": {
        "operationId": "get_keys_encryption",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Encryption keys",
        "tags": [
          "keys"
        ],
        "description": "Per purpose (provider, dkim, webhook): keys, state and how many values each seals. Never key material. Permission: `settings:manage`. Needs step-up (a sign-in with a second factor within 5 minutes); otherwise 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge.",
        "x-step-up": true,
        "x-permission": "settings:manage"
      }
    },
    "/api/v1/keys/encryption/{purpose}/rotate": {
      "post": {
        "operationId": "post_keys_encryption_purpose_rotate",
        "parameters": [
          {
            "in": "path",
            "name": "purpose",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Rotate an encryption key",
        "tags": [
          "keys"
        ],
        "description": "Retires the active key; the schedule re-encrypts what it sealed and then destroys it. Permission: `settings:manage`. Needs step-up (a sign-in with a second factor within 5 minutes); otherwise 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge.",
        "x-step-up": true,
        "x-permission": "settings:manage"
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "get_me",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Who am I",
        "tags": [
          "me"
        ],
        "description": "The token's subject, tenant, MailOS roles and the permissions they grant. Permission: `templates:read`.",
        "x-permission": "templates:read"
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "get_openapi_json",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [],
        "summary": "Route",
        "tags": [
          "openapi.json"
        ],
        "x-stub": true
      }
    },
    "/api/v1/organizations": {
      "get": {
        "operationId": "get_organizations",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List organizations",
        "tags": [
          "organizations"
        ],
        "description": "The caller's own tenant only; tenants come from IAM and are provisioned on first use. Permission: `settings:read`.",
        "x-permission": "settings:read"
      }
    },
    "/api/v1/organizations/{id}": {
      "get": {
        "operationId": "get_organizations_id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get organization",
        "tags": [
          "organizations"
        ],
        "description": "The caller's own tenant; any other id is 404. Permission: `settings:read`.",
        "x-permission": "settings:read"
      }
    },
    "/api/v1/tenant/settings": {
      "get": {
        "operationId": "get_tenant_settings",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get tenant settings",
        "tags": [
          "tenant"
        ],
        "description": "Four-eyes publishing and message retention. Permission: `settings:read`.",
        "x-permission": "settings:read"
      },
      "put": {
        "operationId": "put_tenant_settings",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Update tenant settings",
        "tags": [
          "tenant"
        ],
        "description": "Audited with before and after. Permission: `settings:manage`. Needs step-up (a sign-in with a second factor within 5 minutes); otherwise 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge.",
        "x-step-up": true,
        "x-permission": "settings:manage"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
