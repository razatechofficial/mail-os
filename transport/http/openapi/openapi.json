{
  "components": {
    "responses": {
      "Error": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Error envelope"
      }
    },
    "schemas": {
      "Error": {
        "properties": {
          "error": {
            "properties": {
              "acr_values": {
                "type": "string"
              },
              "code": {
                "enum": [
                  "BAD_REQUEST",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "STEP_UP_REQUIRED",
                  "FOUR_EYES_REQUIRED",
                  "NOT_FOUND",
                  "CONFLICT",
                  "VALIDATION",
                  "RATE_LIMITED",
                  "INTERNAL_SERVER_ERROR",
                  "SERVICE_UNAVAILABLE",
                  "PAYLOAD_TOO_LARGE"
                ],
                "type": "string"
              },
              "details": {
                "items": {
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "max_age": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "retry_after_seconds": {
                "type": "integer"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": "object"
          },
          "request_id": {
            "type": "string"
          },
          "success": {
            "const": false,
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "type": "object"
      },
      "Template": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "org_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "slug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "category": {
            "type": "string",
            "enum": [
              "transactional",
              "marketing",
              "notification"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "topic": {
            "type": "string"
          },
          "default_locale": {
            "type": "string",
            "enum": [
              "en",
              "ur"
            ]
          },
          "is_active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TemplateInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "slug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "enum": [
              "transactional",
              "marketing",
              "notification"
            ]
          },
          "topic": {
            "type": "string"
          },
          "default_locale": {
            "type": "string",
            "enum": [
              "en",
              "ur"
            ]
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "Draft": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ur"
            ]
          },
          "subject": {
            "type": "string",
            "maxLength": 998
          },
          "preheader": {
            "type": "string",
            "maxLength": 255
          },
          "design": {
            "type": [
              "object",
              "null"
            ],
            "description": "Designer node tree, root \"email\" (max 512 KiB)."
          },
          "html_body": {
            "type": "string",
            "description": "Compiled HTML (max 1 MiB); sanitised on save."
          },
          "text_body": {
            "type": "string",
            "description": "Plain text (max 256 KiB)."
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "template_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer"
          },
          "updated_by": {
            "type": "string"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DraftInput": {
        "type": "object",
        "required": [
          "locale",
          "revision",
          "subject",
          "html_body",
          "text_body"
        ],
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ur"
            ]
          },
          "subject": {
            "type": "string",
            "maxLength": 998
          },
          "preheader": {
            "type": "string",
            "maxLength": 255
          },
          "design": {
            "type": [
              "object",
              "null"
            ],
            "description": "Designer node tree, root \"email\" (max 512 KiB)."
          },
          "html_body": {
            "type": "string",
            "description": "Compiled HTML (max 1 MiB); sanitised on save."
          },
          "text_body": {
            "type": "string",
            "description": "Plain text (max 256 KiB)."
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "revision": {
            "type": "integer"
          }
        }
      },
      "Version": {
        "type": "object",
        "description": "Immutable once published.",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "en",
              "ur"
            ]
          },
          "subject": {
            "type": "string",
            "maxLength": 998
          },
          "preheader": {
            "type": "string",
            "maxLength": 255
          },
          "design": {
            "type": [
              "object",
              "null"
            ],
            "description": "Designer node tree, root \"email\" (max 512 KiB)."
          },
          "html_body": {
            "type": "string",
            "description": "Compiled HTML (max 1 MiB); sanitised on save."
          },
          "text_body": {
            "type": "string",
            "description": "Plain text (max 256 KiB)."
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "template_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "published"
            ]
          },
          "is_active": {
            "type": "boolean"
          },
          "published_by": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Topic": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "iam",
              "mailos"
            ]
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "text",
                    "url",
                    "email",
                    "datetime",
                    "number",
                    "secret"
                  ]
                },
                "sample": {}
              }
            }
          }
        }
      },
      "Branding": {
        "type": "object",
        "properties": {
          "company_name": {
            "type": "string"
          },
          "logo_url": {
            "type": "string"
          },
          "logo_alt": {
            "type": "string"
          },
          "primary_color": {
            "type": "string"
          },
          "background_color": {
            "type": "string"
          },
          "content_background_color": {
            "type": "string"
          },
          "text_color": {
            "type": "string"
          },
          "link_color": {
            "type": "string"
          },
          "font_family": {
            "type": "string"
          },
          "company_address": {
            "type": "string"
          },
          "footer_text": {
            "type": "string"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "description": "IAM access token (aud mailos or the console client).",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Transactional email for IAM and the MailOS console. Every /api/v1 operation needs an IAM access token (Bearer, or DPoP for sender-constrained tokens). Console users need a MailOS role (mailos_admin, mailos_template_editor, mailos_template_publisher, mailos_operator, mailos_auditor, mailos_viewer); sensitive operations need a sign-in no older than 5 minutes with a second factor and answer 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge otherwise.",
    "title": "MailOS API",
    "version": "2.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/analytics/audit-logs": {
      "get": {
        "description": "The tenant's audit events in IAM's format, newest first. Each read is audited (audit_log.viewed). Permission: `audit:read`.",
        "operationId": "get_analytics_audit_logs",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List audit logs",
        "tags": [
          "analytics"
        ],
        "x-permission": "audit:read"
      }
    },
    "/api/v1/analytics/audit-logs/export": {
      "get": {
        "description": "Up to 10,000 events; audited as audit_log.exported. Permission: `audit:export`. Needs step-up (a sign-in with a second factor within 5 minutes); otherwise 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge.",
        "operationId": "get_analytics_audit_logs_export",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Export audit logs",
        "tags": [
          "analytics"
        ],
        "x-permission": "audit:export",
        "x-step-up": true
      }
    },
    "/api/v1/keys/encryption": {
      "get": {
        "description": "Per purpose (provider, dkim, webhook): keys, state and how many values each seals. Never key material. Permission: `settings:manage`. Needs step-up (a sign-in with a second factor within 5 minutes); otherwise 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge.",
        "operationId": "get_keys_encryption",
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Encryption keys",
        "tags": [
          "keys"
        ],
        "x-permission": "settings:manage",
        "x-step-up": true
      }
    },
    "/api/v1/keys/encryption/{purpose}/rotate": {
      "post": {
        "description": "Retires the active key; the schedule re-encrypts what it sealed and then destroys it. Permission: `settings:manage`. Needs step-up (a sign-in with a second factor within 5 minutes); otherwise 403 STEP_UP_REQUIRED with an RFC 9470 WWW-Authenticate challenge.",
        "operationId": "post_keys_encryption_purpose_rotate",
        "parameters": [
          {
            "in": "path",
            "name": "purpose",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Rotate an encryption key",
        "tags": [
          "keys"
        ],
        "x-permission": "settings:manage",
        "x-step-up": true
      }
    },
